// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Change to "sqlite" for development
  url      = env("DATABASE_URL")
}

// ─── Phase 2: Tasks ───────────────────────────────────────────────────────────

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ─── Phase 3: Focus Sessions ──────────────────────────────────────────────────

model FocusSession {
  id          Int       @id @default(autoincrement())
  duration    Int       // Duration in minutes
  breakTime   Int       @default(5) // Break duration in minutes
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  interrupted Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([startedAt])
  @@map("focus_sessions")
}

// ─── Phase 4: Reminders ───────────────────────────────────────────────────────

model Reminder {
  id           Int               @id @default(autoincrement())
  message      String
  scheduledFor DateTime
  recurring    Boolean           @default(false)
  frequency    ReminderFrequency?
  active       Boolean           @default(true)
  lastTriggered DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([scheduledFor])
  @@index([active])
  @@map("reminders")
}

enum ReminderFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// ─── Phase 5: Productivity Logs (Optional) ────────────────────────────────────

model ProductivityLog {
  id              Int      @id @default(autoincrement())
  date            DateTime @default(now())
  tasksCompleted  Int      @default(0)
  focusMinutes    Int      @default(0)
  focusSessions   Int      @default(0)
  productivityScore Float  @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([date])
  @@index([date])
  @@map("productivity_logs")
}
